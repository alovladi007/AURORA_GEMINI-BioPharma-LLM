# Pharma AI Platform - Environment Configuration
# Copy this file to .env and update values as needed

# ============================================
# GENERAL
# ============================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ============================================
# BACKEND API
# ============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
PROJECT_NAME="Pharma AI Platform"

# CORS - Update for production
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ============================================
# FRONTEND
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Pharma AI Platform"

# ============================================
# DATABASE (PostgreSQL)
# ============================================
POSTGRES_SERVER=db
POSTGRES_USER=pharma_user
POSTGRES_PASSWORD=pharma_password_change_in_production
POSTGRES_DB=pharma_db
POSTGRES_PORT=5432

# SQLAlchemy connection string (auto-constructed from above)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# ============================================
# REDIS (Caching & Task Queue)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ============================================
# SECURITY & AUTH
# ============================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password hashing
PASSWORD_MIN_LENGTH=8

# ============================================
# MACHINE LEARNING
# ============================================
# Model storage path (inside container)
MODEL_ARTIFACTS_PATH=/app/ml/models/artifacts
DATASET_PATH=/app/ml/data

# Default ML settings
DEFAULT_BATCH_SIZE=32
DEFAULT_NUM_EPOCHS=100
EARLY_STOPPING_PATIENCE=10

# PyTorch
TORCH_DEVICE=cpu  # Set to 'cuda' if GPU available

# ============================================
# OBJECT STORAGE
# ============================================
# Local filesystem (for dev) or S3 (for production)
STORAGE_BACKEND=local  # Options: local, s3
STORAGE_LOCAL_PATH=/app/storage

# S3 Configuration (if STORAGE_BACKEND=s3)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=pharma-ai-platform
# AWS_REGION=us-east-1

# ============================================
# GRAPH DATABASE (Optional - for Repurposing)
# ============================================
# Neo4j configuration (uncomment if using Neo4j)
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=neo4j_password_change_in_production

# ============================================
# MONITORING & LOGGING
# ============================================
SENTRY_DSN=  # Optional: Add Sentry DSN for error tracking
LOG_FORMAT=json  # Options: json, text

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_DRUG_DESIGN=true
ENABLE_CLINICAL_TRIALS=true
ENABLE_REPURPOSING=true
ENABLE_SAFETY=true
ENABLE_GRAPH_DB=false  # Set true if using Neo4j

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================
# DEVELOPMENT
# ============================================
# Auto-reload on code changes
RELOAD=true

# Database initialization
INIT_DB=true
CREATE_SAMPLE_DATA=true

# ============================================
# TESTING
# ============================================
TEST_DATABASE_URL=postgresql://pharma_user:pharma_password_change_in_production@db:5432/pharma_test_db

# ============================================
# EXTERNAL APIs (Optional)
# ============================================
# PubChem API (no key required, but rate-limited)
PUBCHEM_API_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug

# ChEMBL API
CHEMBL_API_URL=https://www.ebi.ac.uk/chembl/api/data

# ClinicalTrials.gov API
CLINICALTRIALS_API_URL=https://clinicaltrials.gov/api/v2
